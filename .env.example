# Development foundation only. Never put real personal data or payment secrets here.
# Runtime: Node 22.13+ (node:sqlite), npm 10+
DEMO_MODE=true
# Paths resolve relative to repository root. data/ is gitignored.
DATABASE_PATH=data/pafupi.sqlite
# API port; Vite's same-origin /api proxy defaults to this port.
PORT=3001
# Override Vite's server-side proxy target if you change PORT.
API_TARGET=http://127.0.0.1:3001
# The API does not automatically load .env. Export variables in your shell,
# or use a process manager that loads them. Defaults work with npm run dev.
