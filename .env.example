# No .env autoload: export these in your shell/process manager. Never commit a real .env.
# Node 22.13+ and npm 10+. Public production startup remains blocked.
AUTH_MODE=demo
# demo uses data/pafupi.sqlite; supabase uses data/accounts.sqlite by default.
# Do not reuse a demo database in account mode.
# DATABASE_PATH=data/accounts.sqlite
PORT=3001
API_TARGET=http://127.0.0.1:3001
# Optional: serve built app and API from one origin (run npm run build first).
# SERVE_FRONTEND=true
# Hosted email/password authentication, when the project owner has configured Supabase:
# AUTH_MODE=supabase
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY
# Only public/publishable keys are accepted. Do NOT use a secret/service-role key.
# Database, payments, provider approval and live support are not connected by setting these values.
